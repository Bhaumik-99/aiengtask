# Optional LLM configuration (OpenAI, Groq, Gemini OpenAI-compatible, or OpenRouter)
# Free-tier examples:
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
ENABLE_LLM_CLASSIFICATION=false

# Optional read-only tool-calling reply agent (`lookup_order` + `search_faq`)
ENABLE_AGENT_TOOLS=false

# Retry & cost-accounting settings (USD per 1M tokens; defaults match gpt-4o-mini / flash tier)
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=0.25
LLM_INPUT_COST_PER_1M=0.15
LLM_OUTPUT_COST_PER_1M=0.60

# Routing threshold (heuristic in rules mode; require calibration before auto-send)
CONFIDENCE_THRESHOLD=0.75

# Required only to run the local webhook; use a random value at least 32 chars long
WEBHOOK_SECRET=
HOST=127.0.0.1
PORT=8080
COPILOT_DB=data/copilot.sqlite3

# Optional Google Sheets sync (requires: pip install -r requirements-sheets.txt)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
